<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>msfs-career</AssemblyName>
    <RootNamespace>MsfsCareer.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MsfsCareer.Core\MsfsCareer.Core.csproj" />
    <ProjectReference Include="..\MsfsCareer.SimLink\MsfsCareer.SimLink.csproj" />
  </ItemGroup>

  <!-- Same SDK lookup as MsfsCareer.SimLink: live recording is only compiled in when the MSFS SDK is installed. -->
  <PropertyGroup>
    <MsfsSdk Condition="'$(MsfsSdk)' == ''">$(MSFS2024_SDK)</MsfsSdk>
    <MsfsSdk Condition="'$(MsfsSdk)' == ''">$(MSFS_SDK)</MsfsSdk>
    <PlatformTarget Condition="'$(MsfsSdk)' != '' And Exists('$(MsfsSdk)\SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll')">x64</PlatformTarget>
    <DefineConstants Condition="'$(PlatformTarget)' == 'x64'">$(DefineConstants);SIMCONNECT</DefineConstants>
  </PropertyGroup>

</Project>
